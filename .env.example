# --- OpenAI ---
OPENAI_API_KEY=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=helix-checkpoint-rag
# Serverless region/cloud (free tier defaults)
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Models (swap here if you justify a different choice in the README) ---
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Corpus path ---
CORPUS_DIR=../YoussefElsafty.AI - LLMs & RAG corpus/corpus


# --- LangSmith (Module 3: tracing + evals) ---
# LANGCHAIN_* spellings also work; ops/langsmith/setup.py sets both.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=helix-csm-assistant
# LLM-as-judge model (deliberately stronger than GENERATION_MODEL)
JUDGE_MODEL=gpt-4o

# --- Arize Phoenix (Module 3: span-level observability) ---
# Local Phoenix launched by `python -m ops.phoenix.instrument`; no key needed.
PHOENIX_PORT=6006
